{
  "name": "aural-client",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "description": "Client for Aural, an open source voice and chat platform with self-hosted servers",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "render-check": "esbuild scripts/render-check.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/aural-render.mjs --jsx=automatic --alias:@=./src --packages=external --log-level=warning && node node_modules/.cache/aural-render.mjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/aural-smoke.mjs --alias:@=./src --packages=external --log-level=warning && node node_modules/.cache/aural-smoke.mjs",
    "icons": "node scripts/make-icon.mjs && tauri icon src-tauri/app-icon.png",
    "emoji": "node scripts/make-emoji.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android dev"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "0.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "gifenc": "^1.0.3",
    "omggif": "^1.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@types/omggif": "^1.0.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

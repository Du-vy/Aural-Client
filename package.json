{
  "name": "aural-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client for Aural, an open source voice and chat platform with self-hosted servers",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "render-check": "esbuild scripts/render-check.tsx --bundle --platform=node --format=esm --outfile=node_modules/.cache/aural-render.mjs --jsx=automatic --alias:@=./src --packages=external --log-level=warning && node node_modules/.cache/aural-render.mjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/aural-smoke.mjs --log-level=warning && node node_modules/.cache/aural-smoke.mjs",
    "icons": "node scripts/make-icon.mjs && tauri icon src-tauri/app-icon.png",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android": "tauri android dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.12.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
